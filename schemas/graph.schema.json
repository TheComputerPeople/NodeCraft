{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/blueprint-vgraph.schema.json",
  "title": "Blueprint Visual Graph (schema 3)",
  "description": "A .vgraph file: a class, function library or macro library containing one or more graphs, or a structure or enumeration declaring a type.",
  "type": "object",
  "required": [
    "schemaVersion",
    "name",
    "kind",
    "variables",
    "graphs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "class",
        "functionLibrary",
        "macroLibrary",
        "structure",
        "enumeration",
        "interface"
      ]
    },
    "language": {
      "type": "string",
      "description": "Target language pack id, e.g. \"typescript\"."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "A structure's, enumeration's or function library's other target languages: it is generated for each of them too, so graphs in any of them use it."
    },
    "parent": {
      "type": "string",
      "pattern": "^(object|code):",
      "description": "A class's parent class: a graph class, as object:<Name>, or a class from the project's code, as code:<language>:<path>#<Class>."
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^interface:"
      },
      "description": "The interfaces a class implements, as interface:<Name>."
    },
    "variables": {
      "type": "array",
      "description": "Member variables, or a structure's fields; must be empty for libraries and enumerations.",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "graphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph"
      },
      "description": "Classes and libraries have at least one graph; structures and enumerations have none."
    },
    "enumerators": {
      "type": "array",
      "description": "An enumeration's values, in order. Values are stored in graphs by id.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "dispatchers": {
      "type": "array",
      "description": "A class's event dispatchers: bound custom events take these inputs.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "inputs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "importedFunctions": {
      "type": "object",
      "description": "The signature of each project function the graphs call, keyed by node type (fn:<language>:<path>#<name>), as it was when its nodes were made or last refreshed. Nodes keep these pins until refreshed when the code changes.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "inputs",
          "outputs"
        ]
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "functionLibrary"
          }
        }
      },
      "then": {
        "properties": {
          "variables": {
            "maxItems": 0
          },
          "graphs": {
            "items": {
              "properties": {
                "kind": {
                  "const": "function"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "macroLibrary"
          }
        }
      },
      "then": {
        "properties": {
          "variables": {
            "maxItems": 0
          },
          "graphs": {
            "items": {
              "properties": {
                "kind": {
                  "const": "macro"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "class",
              "functionLibrary",
              "macroLibrary"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "graphs": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "structure"
          }
        }
      },
      "then": {
        "properties": {
          "graphs": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "enumeration"
          }
        }
      },
      "then": {
        "required": [
          "enumerators"
        ],
        "properties": {
          "variables": {
            "maxItems": 0
          },
          "graphs": {
            "maxItems": 0
          },
          "enumerators": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "const": "class"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "dispatchers"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "const": "class"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "parent"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "not": {
              "const": "class"
            }
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "interfaces"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "interface"
          }
        }
      },
      "then": {
        "properties": {
          "variables": {
            "maxItems": 0
          },
          "graphs": {
            "minItems": 1,
            "items": {
              "properties": {
                "kind": {
                  "const": "function"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "typeRef": {
      "type": "object",
      "description": "Canonical type: bool, int, float, string, any, wildcard, struct:<Name>, enum:<Name>, object:<Class> or native:<qualified name>. For a map, id is the key type.",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "container": {
          "enum": [
            "array",
            "set",
            "map"
          ]
        },
        "valueType": {
          "$ref": "#/$defs/typeRef",
          "description": "Value type when container is \"map\"."
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "variable": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        },
        "defaultValue": {},
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "graphPin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "exec",
            "data"
          ]
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        },
        "defaultValue": {},
        "advanced": {
          "type": "boolean",
          "description": "An input shown under the node's arrow (Unreal's Advanced View)."
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "nodes",
        "connections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the document."
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "event",
            "function",
            "macro"
          ]
        },
        "signature": {
          "type": "object",
          "description": "Inputs and outputs of a function or macro graph; event graphs have none.",
          "required": [
            "inputs",
            "outputs"
          ],
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/graphPin"
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/graphPin"
              }
            },
            "pure": {
              "type": "boolean"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "More words the action menu finds the function or macro by (Unreal's Keywords)."
            },
            "compactTitle": {
              "type": "string",
              "description": "Drawn large on a node without a title bar (Unreal's Compact Node Title)."
            },
            "deprecated": {
              "type": "object",
              "description": "Left out of the action menu; its nodes show and compile with a warning (Unreal's Deprecated).",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        },
        "localVariables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variable"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/connection"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/comment"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "event"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "signature"
          ]
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "position",
        "properties"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique within the graph."
        },
        "type": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "properties": {
          "type": "object",
          "description": "Unconnected input defaults are stored as \"pin:<pinId>\". Variable Get/Set nodes store the id of their variable as \"variable\"."
        }
      }
    },
    "connection": {
      "type": "object",
      "required": [
        "id",
        "fromNode",
        "fromPin",
        "toNode",
        "toPin"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "fromNode": {
          "type": "string"
        },
        "fromPin": {
          "type": "string"
        },
        "toNode": {
          "type": "string"
        },
        "toPin": {
          "type": "string"
        }
      }
    },
    "comment": {
      "type": "object",
      "required": [
        "id",
        "text",
        "position",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "size": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "color": {
          "type": "string"
        }
      }
    }
  }
}
