{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/blueprint-node.schema.json",
  "title": "Visual Node Definition",
  "type": "object",
  "required": ["type", "version", "displayName", "category", "inputs", "outputs"],
  "properties": {
    "type": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "displayName": { "type": "string" },
    "category": { "type": "string" },
    "description": { "type": "string" },
    "color": { "type": "string" },
    "inputs": { "type": "array", "$ref": "#/$defs/pins" },
    "outputs": { "type": "array", "$ref": "#/$defs/pins" },
    "implementation": { "$ref": "#/$defs/implementation" }
  },
  "$defs": {
    "typeRef": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string" }, "nullable": { "type": "boolean" } }
    },
    "pin": {
      "type": "object",
      "required": ["id", "name", "kind", "direction"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "enum": ["exec", "data"] },
        "direction": { "enum": ["input", "output"] },
        "type": { "$ref": "#/$defs/typeRef" },
        "defaultValue": {}
      }
    },
    "pins": {
      "items": { "$ref": "#/$defs/pin" }
    },
    "implementation": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["native", "code", "subgraph"] },
        "operation": { "type": "string" },
        "defaultLanguage": { "type": "string" },
        "languages": { "type": "object", "additionalProperties": { "type": "string" } },
        "graph": { "type": "string" }
      }
    }
  }
}
