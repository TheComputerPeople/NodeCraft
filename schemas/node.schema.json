{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/blueprint-node.schema.json",
  "title": "Visual Node Definition",
  "type": "object",
  "required": [
    "type",
    "version",
    "displayName",
    "category",
    "inputs",
    "outputs"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "$ref": "#/$defs/pins"
    },
    "outputs": {
      "type": "array",
      "$ref": "#/$defs/pins"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra words the action menu matches when searching."
    },
    "examples": {
      "type": "array",
      "description": "Inputs and the outputs they give: Test Node Library runs each in Simulate and in each language, and compares the outputs.",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "description": "Values for the node's data inputs, by pin id."
          },
          "outputs": {
            "type": "object",
            "description": "The values its data outputs give, by pin id."
          }
        },
        "additionalProperties": false
      }
    },
    "compactTitle": {
      "type": "string",
      "description": "Drawn large on a node without a title bar, as + is (Unreal's CompactNodeTitle)."
    },
    "deprecated": {
      "type": "object",
      "description": "Left out of the action menu; its nodes show and compile with a warning (Unreal's DeprecatedFunction).",
      "properties": {
        "message": {
          "type": "string",
          "description": "What to use instead."
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "enum": [
          "classes",
          "inheritance",
          "interfaces",
          "async",
          "delegates",
          "generics",
          "exceptions",
          "array",
          "set",
          "map"
        ]
      },
      "description": "What the node needs from a graph's language beyond what its pin types say; the editor hides it, and the compiler reports it, in languages without these."
    }
  },
  "$defs": {
    "typeRef": {
      "type": "object",
      "description": "Canonical type: bool, int, float, string, any, wildcard, struct:<Name>, enum:<Name>, object:<Class> or native:<qualified name>. For a map, id is the key type.",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "container": {
          "enum": [
            "array",
            "set",
            "map"
          ]
        },
        "valueType": {
          "$ref": "#/$defs/typeRef",
          "description": "Value type when container is \"map\"."
        },
        "nullable": {
          "type": "boolean"
        }
      }
    },
    "pin": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "direction"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "exec",
            "data"
          ]
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "type": {
          "$ref": "#/$defs/typeRef"
        },
        "defaultValue": {},
        "advanced": {
          "type": "boolean",
          "description": "An input folded under the node's arrow until opened, wired or set (Unreal's AdvancedDisplay)."
        }
      }
    },
    "pins": {
      "items": {
        "$ref": "#/$defs/pin"
      }
    },
    "implementation": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "native",
            "code",
            "function",
            "event"
          ]
        },
        "operation": {
          "type": "string"
        },
        "defaultLanguage": {
          "type": "string"
        },
        "languages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "graph": {
          "type": "string"
        },
        "language": {
          "description": "function: the module's language (typescript, javascript or python).",
          "type": "string"
        },
        "path": {
          "description": "function: the module's path relative to the workspace folder, with / separators.",
          "type": "string"
        },
        "name": {
          "description": "function: the function's exported name.",
          "type": "string"
        },
        "module": {
          "description": "function, Python only: the module's import name, such as game.combat.",
          "type": "string"
        },
        "method": {
          "type": "string",
          "description": "An event (kind \"event\"): the method generated code gives it, before each language's naming style; the framework host calls it."
        }
      }
    }
  }
}
