{
  "$schema": "../../../schemas/node.schema.json",
  "type": "universal-utils:text.is-empty",
  "version": 1,
  "displayName": "Is Empty",
  "category": "Utilities / Text",
  "description": "True if the text has no characters. Whitespace counts as characters.",
  "keywords": [
    "empty",
    "length"
  ],
  "inputs": [
    {
      "id": "text",
      "name": "Text",
      "kind": "data",
      "direction": "input",
      "type": {
        "id": "string"
      },
      "defaultValue": ""
    }
  ],
  "outputs": [
    {
      "id": "returnValue",
      "name": "Return Value",
      "kind": "data",
      "direction": "output",
      "type": {
        "id": "bool"
      }
    }
  ],
  "implementation": {
    "kind": "code",
    "languages": {
      "javascript": "return text.length === 0;",
      "python": "return len(text) == 0",
      "csharp": "return text.Length == 0;",
      "cpp": "return text.empty();",
      "rust": "return text.is_empty();",
      "java": "return text.isEmpty();",
      "go": "return text == \"\""
    }
  }
}
