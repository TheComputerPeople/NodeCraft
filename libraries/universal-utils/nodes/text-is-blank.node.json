{
  "$schema": "../../../schemas/node.schema.json",
  "type": "universal-utils:text.is-blank",
  "version": 1,
  "displayName": "Is Blank",
  "category": "Utilities / Text",
  "description": "True if the text is empty or only whitespace.",
  "keywords": [
    "empty",
    "whitespace",
    "blank"
  ],
  "inputs": [
    {
      "id": "text",
      "name": "Text",
      "kind": "data",
      "direction": "input",
      "type": {
        "id": "string"
      },
      "defaultValue": ""
    }
  ],
  "outputs": [
    {
      "id": "returnValue",
      "name": "Return Value",
      "kind": "data",
      "direction": "output",
      "type": {
        "id": "bool"
      }
    }
  ],
  "implementation": {
    "kind": "code",
    "languages": {
      "javascript": "return text.trim() === '';",
      "python": "return text.strip() == \"\"",
      "csharp": "return string.IsNullOrWhiteSpace(text);",
      "cpp": "for (unsigned char c : text) if (!std::isspace(c)) return false;\nreturn true;",
      "rust": "return text.trim().is_empty();",
      "java": "return text.isBlank();",
      "go": "return strings.TrimSpace(text) == \"\""
    }
  }
}
