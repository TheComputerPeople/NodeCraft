{
  "name": "blueprint-visual-scripting",
  "displayName": "Blueprint Visual Scripting",
  "description": "Language-neutral Blueprint-style visual scripting for VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/blueprint-visual-scripting"
  },
  "engines": {
    "vscode": ">=1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "blueprint",
    "visual scripting",
    "nodes",
    "graph",
    "visual programming"
  ],
  "activationEvents": [
    "onCustomEditor:blueprintVisualScripting.graphEditor",
    "onCommand:blueprintVisualScripting.createGraph",
    "onCommand:blueprintVisualScripting.newNode",
    "onCommand:blueprintVisualScripting.testNodeLibrary",
    "onCommand:blueprintVisualScripting.addBlueprintPackage"
  ],
  "main": "./dist/extension/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Graphs can be viewed and edited, but running them is disabled because code nodes from workspace node libraries execute inside the extension host."
    }
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "*.vgraph-language.json",
        "url": "./schemas/language-pack.schema.json"
      },
      {
        "fileMatch": "*.vgraph-package.json",
        "url": "./schemas/node-package.schema.json"
      },
      {
        "fileMatch": "*.node.json",
        "url": "./schemas/node.schema.json"
      }
    ],
    "commands": [
      {
        "command": "blueprintVisualScripting.createGraph",
        "title": "New Graph",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.newNode",
        "title": "New Node",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.testNodeLibrary",
        "title": "Test Node Library",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.addBlueprintPackage",
        "title": "Add Blueprint Package...",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.compile",
        "title": "Compile Graph",
        "category": "Blueprint Visual Scripting",
        "icon": "$(check)"
      },
      {
        "command": "blueprintVisualScripting.run",
        "title": "Run Graph",
        "category": "Blueprint Visual Scripting",
        "icon": "$(play)"
      },
      {
        "command": "blueprintVisualScripting.registerGeneratedFiles",
        "title": "Register Generated Files with the Build",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.runTests",
        "title": "Run Tests",
        "category": "Blueprint Visual Scripting",
        "icon": "$(beaker)"
      },
      {
        "command": "blueprintVisualScripting.simulateTests",
        "title": "Simulate Tests",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.debug",
        "title": "Debug Graph",
        "category": "Blueprint Visual Scripting",
        "icon": "$(debug-alt)"
      },
      {
        "command": "blueprintVisualScripting.findInAll",
        "title": "Find in All Blueprints",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.refreshAllNodes",
        "title": "Refresh All Nodes",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.debug.resume",
        "title": "Resume",
        "category": "Blueprint Visual Scripting",
        "enablement": "blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stepOver",
        "title": "Step Over",
        "category": "Blueprint Visual Scripting",
        "enablement": "blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stepInto",
        "title": "Step Into",
        "category": "Blueprint Visual Scripting",
        "enablement": "blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stepOut",
        "title": "Step Out",
        "category": "Blueprint Visual Scripting",
        "enablement": "blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stop",
        "title": "Stop Debugging",
        "category": "Blueprint Visual Scripting",
        "enablement": "blueprintVisualScripting.debugging"
      }
    ],
    "customEditors": [
      {
        "viewType": "blueprintVisualScripting.graphEditor",
        "displayName": "Blueprint Visual Graph",
        "selector": [
          {
            "filenamePattern": "*.vgraph"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Blueprint Visual Scripting",
      "properties": {
        "blueprintVisualScripting.autoSaveDelay": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Milliseconds to debounce graph writes to the .vgraph document."
        },
        "blueprintVisualScripting.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compile a graph to its target language whenever it is saved, keeping the generated file next to it up to date."
        },
        "blueprintVisualScripting.exposeAllFunctions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show every public function as a node, by each language's rule: exported (TypeScript, JavaScript), not `_`-prefixed (Python, GDScript, Ruby), `public static` (C#, Java, PHP), `pub` (Rust), capitalized (Go), in a header (C++), in the module's table (Lua). Class members still need `@blueprint`. When off, only declarations whose documentation comment contains `@blueprint` become nodes, as Unreal requires `BlueprintCallable`."
        },
        "blueprintVisualScripting.runCommands": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "markdownDescription": "Command used to run generated code, per language id, overriding the default (`node` for TypeScript and JavaScript; `py -3` or `python3` for Python). Example: `{ \"python\": [\"C:/Python313/python.exe\"] }`."
        },
        "blueprintVisualScripting.runArguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Command-line arguments Run passes to a graph's **Main** event (its Args output). Simulate passes them too."
        },
        "blueprintVisualScripting.defaultLanguage": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The language of new graphs in this folder, by language id (`typescript`, `javascript`, `python`, `csharp`, `cpp`, `rust`, `java`, `go`, or another installed pack's). Set it per folder in a multi-root workspace or a folder's `.vscode/settings.json`. When empty, **New Graph** uses the project files nearest to where the graph is saved (`tsconfig.json`, `pyproject.toml`, `go.mod`, ...)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "blueprintVisualScripting.compile",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor",
          "group": "navigation@1"
        },
        {
          "command": "blueprintVisualScripting.run",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor",
          "group": "navigation@2"
        },
        {
          "command": "blueprintVisualScripting.runTests",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "blueprintVisualScripting.newNode",
          "when": "explorerResourceIsFolder",
          "group": "blueprint@0"
        },
        {
          "command": "blueprintVisualScripting.testNodeLibrary",
          "when": "explorerResourceIsFolder || resourceFilename =~ /\\.node\\.json$/",
          "group": "blueprint@0"
        },
        {
          "command": "blueprintVisualScripting.compile",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@1"
        },
        {
          "command": "blueprintVisualScripting.run",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@2"
        },
        {
          "command": "blueprintVisualScripting.runTests",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@3"
        }
      ],
      "commandPalette": [
        {
          "command": "blueprintVisualScripting.compile",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor || resourceExtname == .vgraph"
        },
        {
          "command": "blueprintVisualScripting.run",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor || resourceExtname == .vgraph"
        },
        {
          "command": "blueprintVisualScripting.findInAll",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor"
        },
        {
          "command": "blueprintVisualScripting.refreshAllNodes",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor"
        }
      ]
    },
    "keybindings": [
      {
        "command": "blueprintVisualScripting.findInAll",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor"
      },
      {
        "command": "blueprintVisualScripting.debug",
        "key": "f5",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor && !inDebugMode && !blueprintVisualScripting.debugging"
      },
      {
        "command": "blueprintVisualScripting.debug.resume",
        "key": "f5",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor && blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stepOver",
        "key": "f10",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor && blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stepInto",
        "key": "f11",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor && blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stepOut",
        "key": "shift+f11",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor && blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stepOut",
        "key": "alt+shift+f11",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor && blueprintVisualScripting.debugPaused"
      },
      {
        "command": "blueprintVisualScripting.debug.stop",
        "key": "shift+f5",
        "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor && blueprintVisualScripting.debugging"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run compile:webview",
    "compile:webview": "esbuild src/webview/editor.ts src/webview/editor.css --bundle --outdir=dist/webview --format=iife --target=es2022 --sourcemap",
    "watch": "tsc -watch -p ./",
    "watch:webview": "npm run compile:webview -- --watch",
    "check": "tsc --noEmit -p ./ && tsc --noEmit -p src/webview && tsc --noEmit -p test",
    "test": "npm run compile:webview && npm run build:test && node --test \"out/test/**/*.test.js\"",
    "test:unit": "npm run build:test && node --test \"out/test/unit/**/*.test.js\"",
    "test:webview": "npm run compile:webview && npm run build:test && node --test \"out/test/webview/**/*.test.js\"",
    "test:conformance": "npm run build:test && node --test \"out/test/conformance/**/*.test.js\"",
    "test:integration": "npm run compile && npm run build:test && node out/test/integration/runTest.js",
    "build:sdk": "node scripts/build-sdk.js",
    "test:sdk": "node scripts/build-sdk.js && node packages/pack-sdk/dist/cli.js javascript --filter flow",
    "test:integration:debuggers": "npm run compile && npm run build:test && node out/test/integration/runTest.js --with-debuggers",
    "build:test": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p test",
    "package": "npm run compile && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/**",
    "src/**",
    "schemas/**",
    "docs/**",
    "visual-nodes/**",
    "sample/**",
    ".vscode/**",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "tsconfig.json"
  ]
}
