{
  "name": "blueprint-visual-scripting",
  "displayName": "Blueprint Visual Scripting",
  "description": "Language-neutral Blueprint-style visual scripting for VS Code.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://example.invalid/blueprint-visual-scripting"
  },
  "engines": {
    "vscode": ">=1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "blueprint",
    "visual scripting",
    "nodes",
    "graph",
    "visual programming"
  ],
  "activationEvents": [
    "onCustomEditor:blueprintVisualScripting.graphEditor",
    "onCommand:blueprintVisualScripting.createGraph"
  ],
  "main": "./dist/extension/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Graphs can be viewed and edited, but running them is disabled because code nodes from workspace node libraries execute inside the extension host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "blueprintVisualScripting.createGraph",
        "title": "New Graph",
        "category": "Blueprint Visual Scripting"
      },
      {
        "command": "blueprintVisualScripting.compile",
        "title": "Compile Graph",
        "category": "Blueprint Visual Scripting",
        "icon": "$(check)"
      },
      {
        "command": "blueprintVisualScripting.run",
        "title": "Run Graph",
        "category": "Blueprint Visual Scripting",
        "icon": "$(play)"
      }
    ],
    "customEditors": [
      {
        "viewType": "blueprintVisualScripting.graphEditor",
        "displayName": "Blueprint Visual Graph",
        "selector": [
          {
            "filenamePattern": "*.vgraph"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "Blueprint Visual Scripting",
      "properties": {
        "blueprintVisualScripting.autoSaveDelay": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Milliseconds to debounce graph writes to the .vgraph document."
        },
        "blueprintVisualScripting.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compile a graph to its target language whenever it is saved, keeping the generated file next to it up to date."
        },
        "blueprintVisualScripting.runCommands": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "markdownDescription": "Command used to run generated code, per language id, overriding the default (`node` for TypeScript and JavaScript; `py -3` or `python3` for Python). Example: `{ \"python\": [\"C:/Python313/python.exe\"] }`."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "blueprintVisualScripting.compile",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor",
          "group": "navigation@1"
        },
        {
          "command": "blueprintVisualScripting.run",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "blueprintVisualScripting.compile",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@1"
        },
        {
          "command": "blueprintVisualScripting.run",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@2"
        }
      ],
      "commandPalette": [
        {
          "command": "blueprintVisualScripting.compile",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor || resourceExtname == .vgraph"
        },
        {
          "command": "blueprintVisualScripting.run",
          "when": "activeCustomEditorId == blueprintVisualScripting.graphEditor || resourceExtname == .vgraph"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run compile:webview",
    "compile:webview": "esbuild src/webview/editor.ts src/webview/editor.css --bundle --outdir=dist/webview --format=iife --target=es2022 --sourcemap",
    "watch": "tsc -watch -p ./",
    "watch:webview": "npm run compile:webview -- --watch",
    "check": "tsc --noEmit -p ./ && tsc --noEmit -p src/webview && tsc --noEmit -p test",
    "test": "npm run compile:webview && npm run build:test && node --test \"out/test/**/*.test.js\"",
    "test:unit": "npm run build:test && node --test \"out/test/unit/**/*.test.js\"",
    "test:webview": "npm run compile:webview && npm run build:test && node --test \"out/test/webview/**/*.test.js\"",
    "test:conformance": "npm run build:test && node --test \"out/test/conformance/**/*.test.js\"",
    "test:integration": "npm run compile && npm run build:test && node out/test/integration/runTest.js",
    "build:test": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p test",
    "package": "npm run compile && npx --yes @vscode/vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/**",
    "src/**",
    "schemas/**",
    "docs/**",
    "visual-nodes/**",
    "sample/**",
    ".vscode/**",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ]
}
