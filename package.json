{
  "name": "nodecraft",
  "displayName": "NodeCraft",
  "description": "NodeCraft brings Unreal Blueprint-style visual scripting to VS Code. Build node graphs that compile to readable code in 12 languages (TypeScript, JavaScript, Python, C#, C++, Rust, Java, Go, Lua, GDScript, Ruby and PHP), then run, test and debug them node by node with each language's own tools.",
  "version": "0.1.2",
  "publisher": "DevinBrasher",
  "license": "SEE LICENSE IN LICENSING.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheComputerPeople/NodeCraft.git"
  },
  "homepage": "https://github.com/TheComputerPeople/NodeCraft#readme",
  "bugs": {
    "url": "https://github.com/TheComputerPeople/NodeCraft/issues"
  },
  "engines": {
    "vscode": ">=1.140.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "blueprint",
    "visual scripting",
    "nodes",
    "graph",
    "visual programming"
  ],
  "activationEvents": [
    "onCustomEditor:nodecraft.graphEditor",
    "onCommand:nodecraft.createGraph",
    "onCommand:nodecraft.newProject",
    "onCommand:nodecraft.setUpProject",
    "onCommand:nodecraft.exposeFunctions",
    "onCommand:nodecraft.newNode",
    "onCommand:nodecraft.testNodeLibrary",
    "onCommand:nodecraft.addBlueprintPackage"
  ],
  "main": "./dist/extension/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Graphs can be viewed, edited and compiled, and the Codebase Map drawn. Run, Simulate, Debug, Run Tests and Test Node Library are disabled, because they run the workspace's code and toolchains; the run settings are read from user settings only.",
      "restrictedConfigurations": [
        "nodecraft.runCommands",
        "nodecraft.runArguments"
      ]
    }
  },
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": "*.vgraph-language.json",
        "url": "./schemas/language-pack.schema.json"
      },
      {
        "fileMatch": "*.vgraph-package.json",
        "url": "./schemas/node-package.schema.json"
      },
      {
        "fileMatch": "*.node.json",
        "url": "./schemas/node.schema.json"
      }
    ],
    "commands": [
      {
        "command": "nodecraft.createGraph",
        "title": "New Graph",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.newProject",
        "title": "New Project...",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.setUpProject",
        "title": "Set Up in This Project",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.exposeFunctions",
        "title": "Expose Functions as Nodes...",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.newNode",
        "title": "New Node",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.testNodeLibrary",
        "title": "Test Node Library",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.addBlueprintPackage",
        "title": "Add Blueprint Package...",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.compile",
        "title": "Compile Graph",
        "category": "NodeCraft",
        "icon": "$(check)"
      },
      {
        "command": "nodecraft.run",
        "title": "Run Graph",
        "category": "NodeCraft",
        "icon": "$(play)"
      },
      {
        "command": "nodecraft.registerGeneratedFiles",
        "title": "Register Generated Files with the Build",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.runTests",
        "title": "Run Tests",
        "category": "NodeCraft",
        "icon": "$(beaker)"
      },
      {
        "command": "nodecraft.simulateTests",
        "title": "Simulate Tests",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.debug",
        "title": "Debug Graph",
        "category": "NodeCraft",
        "icon": "$(debug-alt)"
      },
      {
        "command": "nodecraft.findInAll",
        "title": "Find in All Blueprints",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.showCodebaseMap",
        "title": "Show Codebase Map",
        "category": "NodeCraft",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nodecraft.showInCodebaseMap",
        "title": "Show in Codebase Map",
        "category": "NodeCraft",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "nodecraft.showCallFlow",
        "title": "Show Call Flow",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.showControlFlow",
        "title": "Show Control Flow",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.exposeAsNode",
        "title": "Expose as Node",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.openMapEntity",
        "title": "Open",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.graphBack",
        "title": "Back to the Previous Graph",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.graphForward",
        "title": "Forward to the Next Graph",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.refreshAllNodes",
        "title": "Refresh All Nodes",
        "category": "NodeCraft"
      },
      {
        "command": "nodecraft.debug.resume",
        "title": "Resume",
        "category": "NodeCraft",
        "enablement": "nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stepOver",
        "title": "Step Over",
        "category": "NodeCraft",
        "enablement": "nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stepInto",
        "title": "Step Into",
        "category": "NodeCraft",
        "enablement": "nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stepOut",
        "title": "Step Out",
        "category": "NodeCraft",
        "enablement": "nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stop",
        "title": "Stop Debugging",
        "category": "NodeCraft",
        "enablement": "nodecraft.debugging"
      },
      {
        "command": "nodecraft.comingFromUnreal",
        "title": "Coming from Unreal",
        "category": "NodeCraft"
      }
    ],
    "customEditors": [
      {
        "viewType": "nodecraft.graphEditor",
        "displayName": "Blueprint Visual Graph",
        "selector": [
          {
            "filenamePattern": "*.vgraph"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "nodecraft.codebaseStructure",
          "name": "Codebase Map",
          "icon": "$(type-hierarchy)",
          "visibility": "collapsed"
        }
      ]
    },
    "configuration": {
      "title": "NodeCraft",
      "properties": {
        "nodecraft.autoSaveDelay": {
          "type": "number",
          "default": 150,
          "minimum": 0,
          "description": "Milliseconds the graph editor waits after a change before writing it to the .vgraph file's text document. The file shows as changed until it's saved, as a text file does; 0 writes each change at once."
        },
        "nodecraft.compileOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compile a graph whenever it's saved, keeping the generated file next to it up to date. When off, graphs compile only on Compile (F7), Run, Run Tests and Debug."
        },
        "nodecraft.scanLimit": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "markdownDescription": "The most files of each kind (source files, graphs, node files, package manifests) the extension scans in a workspace, for your code as nodes, graph libraries, node libraries and the Codebase Map (per folder). A scan that reaches it says so once, rather than silently leaving files out."
        },
        "nodecraft.exposeAllFunctions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show every public function as a node, by each language's rule: exported (TypeScript, JavaScript), not `_`-prefixed (Python, GDScript, Ruby), `public static` (C#, Java, PHP), `pub` (Rust), capitalized (Go), in a header (C++), in the module's table (Lua). Class members still need `@blueprint`. When off, only declarations whose documentation comment contains `@blueprint` become nodes, as Unreal requires `BlueprintCallable`."
        },
        "nodecraft.runCommands": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "markdownDescription": "The command Run, Run Tests and Debug start for each language, by language id, in place of the one found on the PATH. The defaults are `node` (TypeScript and JavaScript), `py -3`, `python` or `python3` (Python), `dotnet` (C#), `g++` or `clang++` (C++), `cargo` (Rust), `javac` (Java), `go` (Go), `lua`, `lua5.4` or `lua54` (Lua), `godot`, `godot4` or the `GODOT` environment variable (GDScript), `ruby` (Ruby) and `php` (PHP). Example: `{ \"python\": [\"C:/Python313/python.exe\"], \"gdscript\": [\"C:/Godot/Godot_v4.7.2-stable_win64_console.exe\"] }`."
        },
        "nodecraft.runArguments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Command-line arguments passed to a graph's **Main** event (its Args output) by Run, Simulate and Debug, as they are: nothing in them is substituted or split by a shell."
        },
        "nodecraft.defaultLanguage": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "The language of new graphs in this folder, by language id: `typescript`, `javascript`, `python`, `csharp`, `cpp`, `rust`, `java`, `go`, `lua`, `gdscript`, `ruby`, `php`, or another installed pack's. Set it per folder in a multi-root workspace or in a folder's `.vscode/settings.json`. When empty, **New Graph** uses the project files nearest to where the graph is saved (`tsconfig.json`, `pyproject.toml`, `go.mod`, `project.godot`, ...)."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "nodecraft.compile",
          "when": "activeCustomEditorId == nodecraft.graphEditor",
          "group": "navigation@1"
        },
        {
          "command": "nodecraft.run",
          "when": "activeCustomEditorId == nodecraft.graphEditor",
          "group": "navigation@2"
        },
        {
          "command": "nodecraft.runTests",
          "when": "activeCustomEditorId == nodecraft.graphEditor",
          "group": "navigation@3"
        },
        {
          "command": "nodecraft.showInCodebaseMap",
          "when": "activeCustomEditorId == nodecraft.graphEditor",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "nodecraft.setUpProject",
          "when": "explorerResourceIsFolder",
          "group": "blueprint@0"
        },
        {
          "command": "nodecraft.showCodebaseMap",
          "when": "explorerResourceIsFolder",
          "group": "blueprint@1"
        },
        {
          "command": "nodecraft.showInCodebaseMap",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(ts|mts|cts|tsx|js|mjs|cjs|jsx|py|cs|h|hpp|hh|hxx|c|cpp|cc|cxx|rs|java|go|lua|gd|rb|php|vgraph)$/",
          "group": "blueprint@4"
        },
        {
          "command": "nodecraft.exposeFunctions",
          "when": "!explorerResourceIsFolder && resourceExtname =~ /^\\.(ts|mts|cts|js|mjs|cjs|py|cs|h|hpp|hh|hxx|c|cpp|cc|cxx|rs|java|go|lua|gd|rb|php)$/",
          "group": "blueprint@0"
        },
        {
          "command": "nodecraft.newNode",
          "when": "explorerResourceIsFolder",
          "group": "blueprint@0"
        },
        {
          "command": "nodecraft.testNodeLibrary",
          "when": "explorerResourceIsFolder || resourceFilename =~ /\\.node\\.json$/",
          "group": "blueprint@0"
        },
        {
          "command": "nodecraft.compile",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@1"
        },
        {
          "command": "nodecraft.run",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@2"
        },
        {
          "command": "nodecraft.runTests",
          "when": "resourceExtname == .vgraph",
          "group": "blueprint@3"
        }
      ],
      "editor/context": [
        {
          "command": "nodecraft.exposeFunctions",
          "when": "resourceExtname =~ /^\\.(ts|mts|cts|js|mjs|cjs|py|cs|h|hpp|hh|hxx|c|cpp|cc|cxx|rs|java|go|lua|gd|rb|php)$/",
          "group": "blueprint@0"
        },
        {
          "command": "nodecraft.showInCodebaseMap",
          "when": "resourceExtname =~ /^\\.(ts|mts|cts|tsx|js|mjs|cjs|jsx|py|cs|h|hpp|hh|hxx|c|cpp|cc|cxx|rs|java|go|lua|gd|rb|php)$/",
          "group": "blueprint@1"
        },
        {
          "command": "nodecraft.showCallFlow",
          "when": "resourceExtname =~ /^\\.(ts|mts|cts|tsx|js|mjs|cjs|jsx|py|cs|h|hpp|hh|hxx|c|cpp|cc|cxx|rs|java|go|lua|gd|rb|php)$/",
          "group": "blueprint@2"
        },
        {
          "command": "nodecraft.showControlFlow",
          "when": "resourceExtname =~ /^\\.(ts|mts|cts|tsx|js|mjs|cjs|jsx|py|cs|h|hpp|hh|hxx|c|cpp|cc|cxx|rs|java|go|lua|gd|rb|php)$/",
          "group": "blueprint@3"
        }
      ],
      "commandPalette": [
        {
          "command": "nodecraft.compile",
          "when": "activeCustomEditorId == nodecraft.graphEditor || resourceExtname == .vgraph"
        },
        {
          "command": "nodecraft.run",
          "when": "activeCustomEditorId == nodecraft.graphEditor || resourceExtname == .vgraph"
        },
        {
          "command": "nodecraft.findInAll",
          "when": "activeCustomEditorId == nodecraft.graphEditor"
        },
        {
          "command": "nodecraft.graphBack",
          "when": "activeCustomEditorId == nodecraft.graphEditor"
        },
        {
          "command": "nodecraft.graphForward",
          "when": "activeCustomEditorId == nodecraft.graphEditor"
        },
        {
          "command": "nodecraft.refreshAllNodes",
          "when": "activeCustomEditorId == nodecraft.graphEditor"
        },
        {
          "command": "nodecraft.exposeAsNode",
          "when": "false"
        },
        {
          "command": "nodecraft.openMapEntity",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "nodecraft.showCodebaseMap",
          "when": "view == nodecraft.codebaseStructure",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "nodecraft.showInCodebaseMap",
          "when": "view == nodecraft.codebaseStructure && viewItem =~ /^codemap-(project|module|file|graph-file|graph|type|function|external)/",
          "group": "inline"
        },
        {
          "command": "nodecraft.showCodebaseMap",
          "when": "view == nodecraft.codebaseStructure && viewItem == codemap-folder",
          "group": "inline"
        },
        {
          "command": "nodecraft.showInCodebaseMap",
          "when": "view == nodecraft.codebaseStructure && viewItem =~ /^codemap-(project|module|file|graph-file|graph|type|function|external)/",
          "group": "blueprint@1"
        },
        {
          "command": "nodecraft.showCallFlow",
          "when": "view == nodecraft.codebaseStructure && viewItem =~ /^codemap-(file|graph-file|graph|type|function)/",
          "group": "blueprint@2"
        },
        {
          "command": "nodecraft.showControlFlow",
          "when": "view == nodecraft.codebaseStructure && viewItem =~ /^codemap-(type|function)/",
          "group": "blueprint@3"
        },
        {
          "command": "nodecraft.exposeAsNode",
          "when": "view == nodecraft.codebaseStructure && viewItem =~ /-exposable$/",
          "group": "blueprint@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nodecraft.graphBack",
        "key": "alt+left",
        "mac": "ctrl+-",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.graphCanGoBack"
      },
      {
        "command": "nodecraft.graphForward",
        "key": "alt+right",
        "mac": "ctrl+shift+-",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.graphCanGoForward"
      },
      {
        "command": "nodecraft.findInAll",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "activeCustomEditorId == nodecraft.graphEditor"
      },
      {
        "command": "nodecraft.debug",
        "key": "f5",
        "when": "activeCustomEditorId == nodecraft.graphEditor && !inDebugMode && !nodecraft.debugging"
      },
      {
        "command": "nodecraft.debug.resume",
        "key": "f5",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stepOver",
        "key": "f10",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stepInto",
        "key": "f11",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stepOut",
        "key": "shift+f11",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stepOut",
        "key": "alt+shift+f11",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.debugPaused"
      },
      {
        "command": "nodecraft.debug.stop",
        "key": "shift+f5",
        "when": "activeCustomEditorId == nodecraft.graphEditor && nodecraft.debugging"
      }
    ],
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get Started with NodeCraft",
        "description": "Make a graph, run it in your language, debug it node by node, and use your own code as nodes.",
        "featuredFor": [
          "**/*.vgraph"
        ],
        "steps": [
          {
            "id": "newProject",
            "title": "Make a project",
            "description": "Start a project in any of twelve languages, from the Tour: a graph whose comments say what to try.\n[New Project](command:nodecraft.newProject)\nHave code already? [Set Up in This Project](command:nodecraft.setUpProject) says what graphs need there.",
            "media": {
              "markdown": "walkthrough/new-project.md"
            },
            "completionEvents": [
              "onCommand:nodecraft.newProject",
              "onCommand:nodecraft.createGraph"
            ]
          },
          {
            "id": "compileRun",
            "title": "Compile and Run",
            "description": "Open a graph and press **Compile** (F7) to write its code next to it, then **Run** to run that code with your language's toolchain.\n[Open a Graph](command:workbench.action.quickOpen?%5B%22.vgraph%22%5D)",
            "media": {
              "markdown": "walkthrough/compile-run.md"
            },
            "completionEvents": [
              "onContext:nodecraft.hasRun"
            ]
          },
          {
            "id": "simulate",
            "title": "Simulate, with breakpoints",
            "description": "Select a node and press F9 for a breakpoint, then **Simulate**: the graph runs in the editor and pauses there. Hover a pin for its value, and F10 steps.",
            "media": {
              "markdown": "walkthrough/simulate.md"
            },
            "completionEvents": [
              "onContext:nodecraft.debugPaused"
            ]
          },
          {
            "id": "debug",
            "title": "Debug in your language",
            "description": "**Debug** (F5) runs the generated code under your language's debugger, stopping at the same breakpoints and stepping node by node.",
            "media": {
              "markdown": "walkthrough/debug.md"
            },
            "completionEvents": [
              "onContext:nodecraft.hasDebugged"
            ]
          },
          {
            "id": "codeAsNodes",
            "title": "Your code as nodes",
            "description": "Mark a function `@blueprint` and it's a node. On a source file, Expose Functions as Nodes marks the ones you pick.\n[Expose Functions as Nodes](command:nodecraft.exposeFunctions)",
            "media": {
              "markdown": "walkthrough/code-as-nodes.md"
            },
            "completionEvents": [
              "onCommand:nodecraft.exposeFunctions"
            ]
          },
          {
            "id": "codebaseMap",
            "title": "See the whole codebase",
            "description": "The Codebase Map draws your code and graphs top to bottom: architecture, structure, call flow and control flow.\n[Show Codebase Map](command:nodecraft.showCodebaseMap)",
            "media": {
              "markdown": "walkthrough/codebase-map.md"
            },
            "completionEvents": [
              "onCommand:nodecraft.showCodebaseMap"
            ]
          },
          {
            "id": "comingFromUnreal",
            "title": "Coming from Unreal",
            "description": "Unreal's Blueprint concepts and what they are here: assets, events, nodes, reflection, and what doesn't apply.\n[Open the Guide](command:nodecraft.comingFromUnreal)",
            "media": {
              "markdown": "walkthrough/unreal.md"
            },
            "completionEvents": [
              "onCommand:nodecraft.comingFromUnreal"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && npm run compile:webview",
    "compile:webview": "esbuild src/webview/editor.ts src/webview/editor.css --bundle --outdir=dist/webview --format=iife --target=es2022 --sourcemap && esbuild src/map/map.ts src/map/map.css --bundle --outdir=dist/webview --format=iife --target=es2022 --sourcemap",
    "watch": "tsc -watch -p ./",
    "watch:webview": "npm run compile:webview -- --watch",
    "check": "tsc --noEmit -p ./ && tsc --noEmit -p src/webview && tsc --noEmit -p src/map && tsc --noEmit -p test",
    "test": "npm run compile:webview && npm run build:test && node --test \"out/test/**/*.test.js\"",
    "test:unit": "npm run build:test && node --test \"out/test/unit/**/*.test.js\"",
    "test:webview": "npm run compile:webview && npm run build:test && node --test \"out/test/webview/**/*.test.js\"",
    "test:conformance": "npm run build:test && node --test \"out/test/conformance/**/*.test.js\"",
    "test:integration": "npm run compile && npm run build:test && node out/test/integration/runTest.js",
    "build:sdk": "node scripts/build-sdk.js",
    "build:grammars": "node scripts/build-grammars.js",
    "corpus:tools": "node scripts/corpus-tools.js",
    "test:sdk": "node scripts/build-sdk.js && node packages/pack-sdk/dist/cli.js javascript --filter flow",
    "test:integration:debuggers": "npm run compile && npm run build:test && node out/test/integration/runTest.js --with-debuggers",
    "build:test": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && tsc -p test",
    "package": "node scripts/marketplace-readme.js && npx --yes @vscode/vsce package --allow-missing-repository --readme-path out/marketplace/README.md && node scripts/check-package.js",
    "vscode:prepublish": "npm run compile",
    "test:package": "node scripts/test-package.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.140.0",
    "@vscode/test-electron": "^3.1.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "tree-sitter-cli": "0.27.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "elkjs": "0.12.0",
    "web-tree-sitter": "0.27.1"
  }
}
