# What the published extension holds: everything is left out, then what it uses at runtime is let
# back in. vsce adds the production dependencies (elkjs, web-tree-sitter) from node_modules itself.
# scripts/check-package.js checks a built .vsix against this.
**
!package.json
!README.md
!CHANGELOG.md
!LICENSE
!LICENSING.md
!THIRD_PARTY_NOTICES.md
!dist/**
!grammars/**
!schemas/**
!walkthrough/**
!docs/**
!node_modules/**
