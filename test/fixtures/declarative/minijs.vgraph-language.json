{
  "$schema": "../../../schemas/language-pack.schema.json",
  "id": "minijs",
  "displayName": "Mini JS",
  "apiVersion": 1,
  "fileName": "{{name}}.vgraph.mini.js",
  "workspaceMarkers": [],
  "capabilities": {
    "staticTyping": false,
    "exceptions": true,
    "containers": [
      "array",
      "set",
      "map"
    ]
  },
  "snippetLanguages": [
    "javascript"
  ],
  "types": {
    "map": {
      "int": "number",
      "float": "number",
      "bool": "boolean",
      "string": "string",
      "any": "any",
      "array": "{{T}}[]",
      "set": "Set<{{T}}>",
      "map": "Map<{{K}}, {{V}}>"
    },
    "defaults": {
      "int": "0",
      "float": "0",
      "bool": "false",
      "string": "\"\"",
      "any": "null",
      "array": "[]",
      "set": "new Set()",
      "map": "new Map()"
    }
  },
  "naming": {
    "reserved": [
      "break",
      "case",
      "catch",
      "class",
      "const",
      "continue",
      "debugger",
      "default",
      "delete",
      "do",
      "else",
      "export",
      "extends",
      "finally",
      "for",
      "function",
      "if",
      "import",
      "in",
      "instanceof",
      "new",
      "return",
      "super",
      "switch",
      "this",
      "throw",
      "try",
      "typeof",
      "var",
      "void",
      "while",
      "with",
      "yield",
      "let",
      "static",
      "await",
      "null",
      "true",
      "false",
      "undefined",
      "NaN",
      "Infinity",
      "arguments",
      "eval",
      "constructor",
      "formatValue",
      "module",
      "require",
      "console",
      "Math",
      "Number",
      "String",
      "Boolean",
      "Object",
      "Array",
      "Set",
      "Map",
      "JSON",
      "Error"
    ],
    "function": "camel",
    "variable": "camel",
    "parameter": "camel"
  },
  "operators": {
    "==": "===",
    "!=": "!=="
  },
  "templates": {
    "file": "// Generated by Blueprint Visual Scripting from {{sourceFileName}} (Mini JS, a declarative test pack).\n\"use strict\";\n{{#each imports}}\nconst { {{#each names \", \"}}{{this}}{{/each}} } = require(\"{{relative}}\");\n{{/each}}\n\n{{#if library}}\n{{#each all}}\n{{> this}}\n\n{{/each}}\nmodule.exports = { {{#each signatures \", \"}}{{name}}{{/each}} };\n{{else}}\nclass {{className}} {\n  constructor() {\n{{#each fields}}\n    this.{{name}} = {{value}};\n{{/each}}\n  }\n\n{{#each all}}\n  {{> this}}\n\n{{/each}}\n}\n\nif (require.main === module) {\n  const args = process.argv.slice(2);\n  if (args[0] === \"--test\") {\n    let failed = 0;\n    for (let i = 1; i + 1 < args.length; i += 2) {\n      try {\n        new {{className}}()[args[i + 1]]();\n        console.log(\"PASS \" + args[i]);\n      } catch (error) {\n        failed++;\n        console.log(\"FAIL \" + args[i] + \": \" + (error && error.message));\n      }\n    }\n    process.exit(failed ? 1 : 0);\n  }\n  const app = new {{className}}();\n  app.{{startName}}();\n{{#if hasMain}}\n  app.{{mainMethod}}(args);\n{{/if}}\n}\n{{/if}}\n\n{{> support}}\n",
    "function": "{{#if library}}function {{/if}}{{name}}({{#each params \", \"}}{{name}}{{/each}}) {\n  {{> body}}\n}",
    "comment": "// {{text}}",
    "print": "console.log({{text}});",
    "assert": "if (!({{condition}})) throw new Error({{message}});",
    "assign": "{{target}} = {{value}};",
    "declare": "let {{name}} = {{value}};",
    "statement": "{{expression}};",
    "if": "if ({{condition}}) {\n  {{> then}}\n}{{#if else}} else {\n  {{> else}}\n}{{/if}}",
    "while": "while ({{condition}}) {\n  {{> body}}\n}",
    "for": "{{counter}} = {{first}};\nwhile ({{counter}} <= {{last}}{{#if stop}} && !{{stop}}{{/if}}) {\n  {{> body}}\n  {{counter}}++;\n}",
    "forEach": "{{index}} = 0;\nwhile ({{index}} < {{array}}.length{{#if stop}} && !{{stop}}{{/if}}) {\n  {{element}} = {{array}}[{{index}}];\n  {{> body}}\n  {{index}}++;\n}",
    "return": "return{{#if multiple}} [{{#each values \", \"}}{{this}}{{/each}}]{{else}}{{#if value}} {{value}}{{/if}}{{/if}};",
    "callResults": "{\n  const results = {{call}};\n{{#each results}}\n  {{target}} = results[{{index}}];\n{{/each}}\n}",
    "callOutput": "{{call}}[{{index}}]",
    "field": "this.{{name}}",
    "call": "{{#unless library}}this.{{/unless}}{{name}}({{#each args \", \"}}{{this}}{{/each}})",
    "callFunction": "{{#unless library}}this.{{/unless}}{{name}}({{#each args \", \"}}{{this}}{{/each}})",
    "callBlock": "{{#unless library}}this.{{/unless}}{{name}}()",
    "literal.null": "null",
    "toText.int": "String({{value}})",
    "toText.float": "String({{value}})",
    "toText.bool": "String({{value}})",
    "toText": "formatValue({{value}})",
    "toInt": "Math.trunc({{value}})",
    "toNumber": "Number({{value}} ?? 0)",
    "toBoolean": "Boolean({{value}})",
    "concat": "{{#each parts \" + \"}}{{this}}{{/each}}",
    "makeContainer.array": "[{{#each items \", \"}}{{this}}{{/each}}]",
    "makeContainer.set": "new Set([{{#each items \", \"}}{{this}}{{/each}}])",
    "makeContainer.map": "new Map([{{#each pairs \", \"}}[{{key}}, {{value}}]{{/each}}])"
  },
  "helpers": {
    "formatValue": "function formatValue(value) {\n  if (value === null || value === undefined) return \"\";\n  if (typeof value === \"string\") return value;\n  if (typeof value === \"number\" || typeof value === \"boolean\") return String(value);\n  return JSON.stringify(value, (_key, v) => v instanceof Set ? [...v].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)) : v instanceof Map ? Object.fromEntries(v) : v) ?? \"\";\n}"
  },
  "importer": {
    "extensions": [
      ".js"
    ],
    "comments": [
      "/**",
      "*",
      "//"
    ],
    "parameters": "name: type",
    "returns": "after",
    "ignore": [
      "function",
      "export",
      "async",
      "declare"
    ]
  },
  "runner": {
    "commands": [
      [
        "node"
      ]
    ],
    "run": [
      "{{file}}",
      "{{args}}"
    ],
    "test": [
      "{{file}}",
      "--test",
      "{{tests}}"
    ],
    "missingToolMessage": "Node.js was not found. Install Node.js and make sure `node` is on the PATH."
  },
  "debugger": {
    "type": "node",
    "configuration": {
      "type": "node",
      "request": "launch",
      "program": "{{file}}",
      "args": "{{args}}",
      "cwd": "{{cwd}}",
      "console": "internalConsole"
    }
  }
}
