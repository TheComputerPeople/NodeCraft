            "pin:b": 4
          }
        },
        {
          "id": "at",
          "type": "core:test.assert-true",
          "position": {
            "x": 0,
            "y": 320
          },
          "properties": {
            "pin:message": "more than four"
          }
        },
        {
          "id": "t2",
          "type": "core:test.case",
          "position": {
            "x": 260,
            "y": 320
          },
          "properties": {
            "name": "Fails on purpose"
          }
        },
        {
          "id": "eq2",
          "type": "core:test.assert-equal",
          "position": {
            "x": 520,
            "y": 320
          },
          "properties": {
            "wildcards": {
              "wildcard": "int"
            },
            "pin:actual": 1,
            "pin:expected": 2,
            "pin:message": "math"
          }
        }
      ],
      "connections": [
        {
