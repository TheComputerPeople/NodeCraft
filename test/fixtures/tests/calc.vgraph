          "position": {
            "x": 0,
            "y": 160
          },
          "properties": {
            "variable": "v_score"
          }
        },
        {
          "id": "eq",
          "type": "core:test.assert-equal",
          "position": {
            "x": 260,
            "y": 160
          },
          "properties": {
            "wildcards": {
              "wildcard": "float"
            },
            "pin:expected": 5
