      "nodes": [
        {
          "id": "t1",
          "type": "core:test.case",
          "position": {
            "x": 0,
            "y": 0
          },
          "properties": {
            "name": "Adds up"
          }
        },
        {
          "id": "add",
          "type": "core:math.add",
          "position": {
            "x": 260,
            "y": 0
          },
          "properties": {
            "pin:a": 2,
            "pin:b": 3
          }
        },
        {
          "id": "set",
          "type": "core:variable.set",
          "position": {
            "x": 520,
            "y": 0
          },
          "properties": {
            "variable": "v_score"
          }
        },
        {
          "id": "get",
